# Copy to .env for local development. On Vercel, add the same names in Project Settings -> Environment Variables.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local: `docker compose up -d` starts Postgres on 5432 with these values.
# Vercel: use a hosted Postgres from the Marketplace (e.g. Neon).
#   DATABASE_URL = the POOLED connection string (app traffic)
#   DIRECT_URL   = the DIRECT / UNPOOLED connection string (migrations). On Neon this is DATABASE_URL_UNPOOLED.
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/alpha_dev
DIRECT_URL=postgresql://postgres:devpass@localhost:5432/alpha_dev

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: random string, 32+ characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Site address ─────────────────────────────────────────────────────────────
# Public address of the site. Used for links in customer messages and for search-engine tags.
STORE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty: the API lives in this same project at /api. Only set it to use an API on a different server.
NEXT_PUBLIC_API_URL=

# ── First staff accounts (used by `npm run db:seed`) ─────────────────────────
# If a password is empty, a random one is generated and printed once.
SEED_ADMIN_EMAIL=admin@alphacomputers.co.ke
SEED_ADMIN_PASSWORD=
SEED_INVENTORY_EMAIL=inventory@alphacomputers.co.ke
SEED_INVENTORY_PASSWORD=

# ── Product photos (Vercel Blob) ─────────────────────────────────────────────
# Add a Blob store to the Vercel project and this is filled in for you. Without it, uploads only work in `npm run dev`.
BLOB_READ_WRITE_TOKEN=

# ── Customer messages. Each channel is skipped (not an error) while its key is empty ──
# Email via Resend (the sender domain must be verified in Resend)
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.co.ke
# WhatsApp via WaSender
WASENDER_API_KEY=

# ── M-Pesa prompt (Safaricom Daraja). Optional ───────────────────────────────
# Paying by paybill/till and entering the M-Pesa code works without any of these.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public https address Safaricom calls back, WITHOUT the token, e.g. https://yourdomain.co.ke/api/payments/mpesa/callback
MPESA_CALLBACK_URL=
# Secret appended to that address so only Safaricom can confirm payments. Use a long random string.
MPESA_CALLBACK_TOKEN=
