# Database. Local dev: `docker compose up -d` starts Postgres on 5432 (password: devpass).
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/alpha_dev
DIRECT_URL=postgresql://postgres:devpass@localhost:5432/alpha_dev

# JWT
# REQUIRED: random string, 32+ chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Browser origins allowed to call the API (comma separated). In production, set this to your store's address.
CORS_ORIGINS=http://localhost:8080

# Public address of the storefront, used for the "track your order" links in customer messages
STORE_URL=http://localhost:8080

# Optional seed credentials (random ones are generated and printed if unset)
SEED_ADMIN_EMAIL=admin@alphacomputers.co.ke
SEED_ADMIN_PASSWORD=
SEED_INVENTORY_EMAIL=inventory@alphacomputers.co.ke
SEED_INVENTORY_PASSWORD=

# Customer messages. Each channel is skipped (not an error) while its key is empty.
# Email via Resend: the sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=orders@yourdomain.co.ke
# WhatsApp via WaSender
WASENDER_API_KEY=

# M-Pesa prompt (Safaricom Daraja). Only needed if you switch on "M-Pesa prompt" in Shop setup.
# Paying by paybill/till and entering the M-Pesa code works without any of these.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public https address Safaricom calls back, WITHOUT the token, e.g. https://api.yourdomain.co.ke/payments/mpesa/callback
MPESA_CALLBACK_URL=
# Secret appended to the callback address so only Safaricom can confirm payments. Use a long random string.
MPESA_CALLBACK_TOKEN=

# File Upload (note: local disk is wiped on serverless hosts; use a persistent disk or object storage in production)
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
APP_URL=http://localhost:3000

# App
PORT=3000
NODE_ENV=development
