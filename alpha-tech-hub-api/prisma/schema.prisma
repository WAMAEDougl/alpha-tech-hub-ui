// Prisma Schema — Alpha Computers Nanyuki Backend
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  CARD
  PAY_ON_DELIVERY
}

enum RepairStatus {
  RECEIVED
  DIAGNOSTIC
  AWAITING_PARTS
  IN_REPAIR
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  phone     String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  cartItems    CartItem[]
  repairTickets RepairTicket[]

  @@map("users")
}

// ─────────────────────────────────────────────
// SETTINGS (singleton row — id always = 1)
// ─────────────────────────────────────────────

model Settings {
  id             Int      @id @default(autoincrement())
  companyName    String   @default("Alpha Computers Nanyuki")
  logoUrl        String?
  contactEmail   String?
  whatsappNumber String?
  locationLat    Decimal? @db.Decimal(10, 7)
  locationLng    Decimal? @db.Decimal(10, 7)
  address        String?
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String   @unique
  brand       String
  category    String
  condition   String   @default("New")
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  summary     String?
  description String?
  images      String[] @default([])
  specs       Json     @default("[]")
  rating      Decimal  @default(5) @db.Decimal(3, 1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

// ─────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id                 String        @id @default(uuid())
  userId             String
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod @default(PAY_ON_DELIVERY)
  totalAmount        Decimal       @db.Decimal(12, 2)
  deliveryAddress    String?
  mpesaReceiptNumber String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ─────────────────────────────────────────────
// REPAIR TICKETS
// ─────────────────────────────────────────────

model RepairTicket {
  id             String       @id @default(uuid())
  ticketNumber   String       @unique
  userId         String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  deviceBrand    String
  deviceModel    String?
  issueDescription String
  status         RepairStatus @default(RECEIVED)
  serviceType    String?
  technician     String?
  technicianNotes String?
  estimatedCost  Decimal?     @db.Decimal(10, 2)
  finalCost      Decimal?     @db.Decimal(10, 2)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("repair_tickets")
}

// ─────────────────────────────────────────────
// CUSTOM BUILD REQUESTS
// ─────────────────────────────────────────────

model BuildRequest {
  id          String   @id @default(uuid())
  name        String
  phone       String
  email       String?
  buildType   String
  budget      String
  useCases    String[] @default([])
  notes       String?
  status      String   @default("New")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("build_requests")
}

// ─────────────────────────────────────────────
// DISPOSAL REQUESTS
// ─────────────────────────────────────────────

model DisposalRequest {
  id            String   @id @default(uuid())
  name          String
  phone         String
  email         String?
  items         String
  quantity      Int      @default(1)
  preferredDate String?
  notes         String?
  status        String   @default("Pending")
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("disposal_requests")
}

// ─────────────────────────────────────────────
// QUOTE REQUESTS
// ─────────────────────────────────────────────

model QuoteRequest {
  id        String   @id @default(uuid())
  name      String
  phone     String
  interest  String
  message   String?
  status    String   @default("New")
  createdAt DateTime @default(now())

  @@map("quote_requests")
}
